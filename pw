<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Free Personal Website</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; background: #0f172a; color: #f8fafc; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .card { background: #1e293b; padding: 40px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); max-width: 500px; width: 100%; text-align: center; border: 1px solid #334155; }
        h1 { font-size: 2rem; color: #38bdf8; margin-bottom: 10px; }
        p { color: #94a3b8; margin-bottom: 24px; }
        .btn-group { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
        a.btn { background: #0284c7; color: white; text-decoration: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; transition: background 0.2s; }
        a.btn:hover { background: #0369a1; }
        a.btn-outline { background: transparent; border: 1px solid #0284c7; color: #38bdf8; }
        a.btn-outline:hover { background: rgba(2, 132, 199, 0.1); }
    </style>
</head>
<body>
    <div class="card">
        <h1>Hello, World! 👋</h1>
        <p>Welcome to my free personal website hosted online.</p>
        <div class="btn-group">
            <a href="mailto:your-email@example.com" class="btn">Contact Me</a>
            <a href="https://github.com" target="_blank" class="btn btn-outline">My GitHub</a>
        </div>
    </div>
</body>
</html>
